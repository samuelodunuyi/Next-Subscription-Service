DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscription-platform?schema=public"

# HMAC secret for payment webhooks. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=""
# only while rotating: the old secret, still accepted
PAYMENT_WEBHOOK_SECRET_PREVIOUS=""

# number of reverse proxies in front of the app (0 if none); required in production
TRUSTED_PROXY_HOPS=0

# extra origins allowed to make browser writes, comma separated
ALLOWED_ORIGINS=

# set to "off" to skip the breached-password lookup
PASSWORD_BREACH_CHECK=

# used by npm run db:seed
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
